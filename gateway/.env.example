# Provider API keys — obtain from each provider's dashboard
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# PostgreSQL connection string
# Local:  postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway
# Fly.io: set via `fly secrets set DATABASE_URL=...`
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway

# Redis connection string
# Local:  redis://localhost:6379/0
# Fly.io: set via `fly secrets set REDIS_URL=...` (use Upstash add-on)
REDIS_URL=redis://localhost:6379/0

# Admin key used to provision other API keys — keep secret, rotate periodically
GATEWAY_MASTER_KEY=change-me-before-deploy-$(openssl rand -hex 16)

# Optional: override log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
